  follow --from <path> --name <text> [--expect text]...
  links <path>
  snapshot <path> --dir <evidence-dir> [--screenshot] [--feature id]
  screenshot <path> --out <evidence-file>
  pick --path <path> --amps 10|13|15 --length 25|50|100 [--expect text]... [--dir <evidence-dir>] [--feature id]
  seo [--dir <evidence-dir>]
  cleanup

Environment: CORDGAUGE_HOST=127.0.0.1 CORDGAUGE_PORT=4321
Port 3000 is refused. Evidence writes must stay under:
  ${EVIDENCE_ROOT}`);
}

async function main() {
  const [command, ...rest] = process.argv.slice(2);
  const flags = parseFlags(rest);
  if (!command || flags.help || command === "help") {
    usage();
    process.exit(command ? 0 : 1);
  }
  const { host, port } = hostPort();
  if (command === "url") {
    console.log(baseUrl(host, port));
    return;
  }
  if (command === "launch") return commandLaunch(host, port);
  if (command === "doctor") return commandDoctor(host, port);
  if (command === "cleanup") return commandCleanup(host, port);
  if (command === "get") return commandGet(host, port, flags);
  if (command === "follow") return commandFollow(host, port, flags);
  if (command === "links") return commandLinks(host, port, flags);
  if (command === "snapshot") return commandSnapshot(host, port, flags);
  if (command === "screenshot") return commandScreenshot(host, port, flags);
  if (command === "pick") return commandPick(host, port, flags);
  if (command === "seo") return commandSeo(host, port, flags);
  fail(`unknown command ${command}`);
}

main().catch((error) => {
  if (error && error.cordGauge) console.error(`cord-gauge: ${error.message}`);
  else console.error(`cord-gauge: ${error.stack || error.message}`);
  process.exit(1);
});
