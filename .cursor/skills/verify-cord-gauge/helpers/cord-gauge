function webSocketImpl() {
  if (typeof WebSocket === "function") return WebSocket;
  return null;
}

function connectWs(Ws, url) {
  return new Promise((resolve, reject) => {
    const ws = new Ws(url);
    const pending = new Map();
    let next = 1;
    const client = {
      onEvent: null,
      send(method, params = {}) {
        const id = next++;
        return new Promise((res, rej) => {
          pending.set(id, { res, rej });
          ws.send(JSON.stringify({ id, method, params }));
        });
      },
    };
    const timer = setTimeout(() => reject(new Error("chrome websocket open timed out")), 10000);
    ws.addEventListener("open", () => {
      clearTimeout(timer);
      resolve(client);
    });
    ws.addEventListener("error", () => {
      clearTimeout(timer);
      reject(new Error("chrome websocket failed"));
    });
    ws.addEventListener("message", (event) => {
      const raw = typeof event.data === "string" ? event.data : Buffer.from(event.data).toString("utf8");
      const message = JSON.parse(raw);
      if (message.id && pending.has(message.id)) {
        const { res, rej } = pending.get(message.id);
        pending.delete(message.id);
        if (message.error) rej(new Error(JSON.stringify(message.error)));
        else res(message.result || {});
      } else if (message.method && client.onEvent) {
        client.onEvent(message);
      }
    });
  });
}

async function readDebugPort(userData) {
  const file = path.join(userData, "DevToolsActivePort");
  const deadline = Date.now() + 10000;
  while (Date.now() < deadline) {
    if (fs.existsSync(file)) {
      const port = Number(fs.readFileSync(file, "utf8").split("\n")[0]);
      if (port > 0) return port;
    }
    await sleep(100);
  }
  throw new Error("chrome did not write DevToolsActivePort");
}

async function withChromePage(url, fn) {
  const chrome = findChrome();
  if (!chrome) fail("chrome missing. Set CORDGAUGE_CHROME. pick cannot be replaced by a GET of the default HTML.");
  const Ws = webSocketImpl();
  if (!Ws) fail("global WebSocket is missing. pick needs Node 22 (this repo's CI version). Do not call the default HTML a calculator pass.");
  const userData = fs.mkdtempSync("/tmp/cord-gauge-chrome-");
  let stderr = "";
  const child = spawn(
    chrome,
    [
      "--headless=new",
      "--no-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--disable-background-networking",
      "--no-first-run",
      "--window-size=1280,900",
      `--user-data-dir=${userData}`,
      "--remote-debugging-port=0",
      "--remote-allow-origins=*",
      "about:blank",
    ],
    { detached: true, stdio: ["ignore", "pipe", "pipe"] },
  );
  child.stderr.on("data", (chunk) => {
    stderr = (stderr + chunk.toString()).slice(-4000);
  });
  try {
    const debugPort = await readDebugPort(userData);
    const version = await fetch(`http://127.0.0.1:${debugPort}/json/version`).then((response) => response.json());
    const browser = await connectWs(Ws, version.webSocketDebuggerUrl);
    const created = await browser.send("Target.createTarget", { url: "about:blank" });
    const list = await fetch(`http://127.0.0.1:${debugPort}/json/list`).then((response) => response.json());
    const pageInfo = list.find((target) => target.id === created.targetId);
    if (!pageInfo?.webSocketDebuggerUrl) throw new Error("chrome did not expose a page websocket");
    const page = await connectWs(Ws, pageInfo.webSocketDebuggerUrl);
    const requests = [];
    page.onEvent = (message) => {
      if (message.method === "Network.requestWillBeSent") requests.push(message.params.request.url);
    };
    await page.send("Network.enable");
    await page.send("Page.enable");
    await page.send("Runtime.enable");
    await page.send("Page.navigate", { url });
    await fn({ page, requests });
  } catch (error) {
    if (stderr) error.message += `\nchrome stderr: ${stderr}`;
    throw error;
  } finally {
    try {
      process.kill(-child.pid, "SIGKILL");
    } catch {
      try {
        process.kill(child.pid, "SIGKILL");
      } catch {
        // Chrome already exited.
      }
    }
    fs.rmSync(userData, { recursive: true, force: true });
  }
}

async function evalPage(page, expression) {
  const result = await page.send("Runtime.evaluate", {
    expression,
    returnByValue: true,
    awaitPromise: true,
  });
  if (result.exceptionDetails) {
    throw new Error(result.exceptionDetails.text || JSON.stringify(result.exceptionDetails));
  }
  return result.result?.value;
}

function forbiddenHost(url) {
  let hostname = "";
  try {
    hostname = new URL(url).hostname;
  } catch {
    return false;
  }
  return PRODUCTION_HOSTS.some((blocked) => hostname === blocked || hostname.endsWith(`.${blocked}`));
}

async function commandPick(host, port, flags) {
  requireInstance(host, port);
  const urlPath = flags.path;
  if (!urlPath || !urlPath.startsWith("/")) fail("pick needs --path /...");
  const amps = String(flags.amps || "");
  const length = String(flags.length || "");
  if (!["10", "13", "15"].includes(amps)) fail("--amps must be 10, 13, or 15");
  if (!["25", "50", "100"].includes(length)) fail("--length must be 25, 50, or 100");
  const dir = flags.dir ? evidencePath(flags.dir) : null;
  if (dir) fs.mkdirSync(dir, { recursive: true });
  const pageUrl = `${baseUrl(host, port)}${urlPath}`;
  let before = "";
  let after = "";
  let requests = [];
  await withChromePage(pageUrl, async ({ page, requests: seen }) => {
    requests = seen;
    const deadline = Date.now() + 30000;
    while (Date.now() < deadline) {
      const text = await evalPage(page, "document.querySelector('form') ? document.querySelector('form').innerText : ''");
      if (typeof text === "string" && text.includes("Shop pick:")) {
        before = text;
        break;
      }
      await sleep(200);
    }
    if (!before.includes("Shop pick:")) fail("gauge form did not render Shop pick");
    if (dir) {
      const png = await page.send("Page.captureScreenshot", { format: "png" });
      fs.writeFileSync(path.join(dir, "before.png"), Buffer.from(png.data, "base64"));
      fs.writeFileSync(path.join(dir, "before.txt"), before);
    }
    const changed = await evalPage(
      page,
      `(() => {
        const form = document.querySelector('form');
        function setSelect(name, value) {
          const el = form.querySelector('select[name="' + name + '"]');
          if (!el) return { ok: false, name };
          const previous = el.value;
          const descriptor = Object.getOwnPropertyDescriptor(window.HTMLSelectElement.prototype, 'value');
          descriptor.set.call(el, String(value));
          if (el._valueTracker) el._valueTracker.setValue(previous);
          el.dispatchEvent(new Event('input', { bubbles: true }));
          el.dispatchEvent(new Event('change', { bubbles: true }));
          return { ok: true, value: el.value };
        }
        return { amps: setSelect('amps', ${JSON.stringify(amps)}), length: setSelect('length', ${JSON.stringify(length)}) };
      })()`,
    );
    const wantChange = !(amps === "15" && length === "50");
    const changeDeadline = Date.now() + 8000;
    let stable = false;
    while (Date.now() < changeDeadline) {
      after = await evalPage(page, "document.querySelector('form').innerText");
      const normalized = collapse(after);
      const expectsOk = flags.expect.every((expect) => normalized.includes(collapse(expect)));
      if (expectsOk && (!wantChange || collapse(after) !== collapse(before))) {
        stable = true;
        break;
      }
      await evalPage(
        page,
        `(() => {
          const form = document.querySelector('form');
          function setSelect(name, value) {
            const el = form.querySelector('select[name="' + name + '"]');
            const previous = el.value;
            const descriptor = Object.getOwnPropertyDescriptor(window.HTMLSelectElement.prototype, 'value');
            descriptor.set.call(el, String(value));
            if (el._valueTracker) el._valueTracker.setValue(previous);
            el.dispatchEvent(new Event('input', { bubbles: true }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
          }
          setSelect('amps', ${JSON.stringify(amps)});
          setSelect('length', ${JSON.stringify(length)});
          return true;
        })()`,
      );
      await sleep(150);
    }
    if (!stable) {
      fail(
        `select change did not stick. before=${JSON.stringify(collapse(before))} after=${JSON.stringify(collapse(after))} set=${JSON.stringify(changed)}`,
      );
    }
    if (dir) {
      const png = await page.send("Page.captureScreenshot", { format: "png" });
      fs.writeFileSync(path.join(dir, "after.png"), Buffer.from(png.data, "base64"));
      const html = await evalPage(page, "document.documentElement.outerHTML");
      fs.writeFileSync(path.join(dir, "after.html"), html);
    }
  });

  const normalizedAfter = collapse(after);
  const misses = flags.expect.filter((expect) => !normalizedAfter.includes(collapse(expect)));
  const hits = requests.filter((url) => forbiddenHost(url));
  console.log(`path: ${urlPath}`);
  console.log(`action: set Nameplate amps=${amps} Run length=${length}`);
  console.log(`before: ${collapse(before)}`);
  console.log(`after: ${normalizedAfter}`);
  if (dir) {
    fs.writeFileSync(path.join(dir, "after.txt"), after);
    fs.writeFileSync(
      path.join(dir, "action.txt"),
      [
        `path: ${urlPath}`,
        `set: Nameplate amps=${amps}`,
        `set: Run length, outlet to tool=${length} ft`,
        `before: ${collapse(before)}`,
        `after: ${normalizedAfter}`,
        "",
      ].join("\n"),
    );
    fs.writeFileSync(path.join(dir, "requests.txt"), requests.join("\n") + (requests.length ? "\n" : ""));
    const meta = {
      url: pageUrl,
      capturedAt: new Date().toISOString(),
      featureId: flags.feature || null,
      amps,
      lengthFt: Number(length),
      forbiddenRequests: hits,
    };
    fs.writeFileSync(path.join(dir, "pick.meta.json"), JSON.stringify(meta, null, 2) + "\n");
    console.log(`dir: ${dir}`);
  }
  if (hits.length) {
    console.log(`forbidden-requests: ${hits.join(" ")}`);
    process.exit(1);
  }
  if (misses.length) {
    for (const miss of misses) console.log(`expect: missing ${JSON.stringify(miss)}`);
    process.exit(1);
  }
  console.log("expect: ok");
  console.log(`requests: ${requests.length}`);
}

function locUrl(urlPath) {
  return urlPath === "/" ? "https://www.cordgaugeguide.com" : `https://www.cordgaugeguide.com${urlPath}`;
}

async function commandSeo(host, port, flags) {
  requireInstance(host, port);
  const dir = flags.dir ? evidencePath(flags.dir) : null;
  if (dir) fs.mkdirSync(dir, { recursive: true });
  const robots = await httpGet(host, port, "/robots.txt");
  const sitemap = await httpGet(host, port, "/sitemap.xml");
  const ads = await httpGet(host, port, "/ads.txt");
  const problems = [];
  if (robots.status !== 200) problems.push(`robots status ${robots.status}`);
  if (sitemap.status !== 200) problems.push(`sitemap status ${sitemap.status}`);
  if (ads.status !== 200) problems.push(`ads status ${ads.status}`);
  for (const needle of [
    "User-Agent: *",
    "Allow: /",
    "Sitemap: https://www.cordgaugeguide.com/sitemap.xml",
    "Host: www.cordgaugeguide.com",
  ]) {
    if (!robots.body.includes(needle)) problems.push(`robots missing ${JSON.stringify(needle)}`);
  }
  const locs = [...sitemap.body.matchAll(/<loc>([^<]+)<\/loc>/g)].map((match) => match[1].trim());
  const expected = SITEMAP_PATHS.map(locUrl);
  const missing = expected.filter((loc) => !locs.includes(loc));
  const extra = locs.filter((loc) => !expected.includes(loc));
  if (missing.length) problems.push(`sitemap missing ${missing.join(", ")}`);
  if (extra.length) problems.push(`sitemap extra ${extra.join(", ")}`);
  const adsBody = ads.body;
  const commentOnly = adsBody.includes("# CordGauge Guide ads.txt placeholder") && !adsBody.includes("pub-");
  const directLine = /^google\.com, pub-[0-9]+, DIRECT, f08c47fec0942fa0\s*$/.test(adsBody.trim());
  if (adsBody.includes("pub-XXXXXXXXXXXXXXXX")) problems.push("ads.txt still contains the placeholder publisher id");
  if (!commentOnly && !directLine) problems.push("ads.txt is neither the comment-only placeholder nor one google.com DIRECT line");
  if (dir) {
    fs.writeFileSync(path.join(dir, "robots.txt"), robots.body);
    fs.writeFileSync(path.join(dir, "sitemap.xml"), sitemap.body);
    fs.writeFileSync(path.join(dir, "ads.txt"), ads.body);
    fs.writeFileSync(
      path.join(dir, "seo.txt"),
      [
        `robots: ${robots.status}`,
        `sitemap-locs: ${locs.length}`,
        `ads: ${commentOnly ? "comment-only" : directLine ? "google.com DIRECT" : "unexpected"}`,
        ...problems.map((problem) => `problem: ${problem}`),
        "",
      ].join("\n"),
    );
  }
  console.log(`robots: ${robots.status}`);
  console.log(`sitemap-locs: ${locs.length}`);
  console.log(`ads: ${commentOnly ? "comment-only" : directLine ? "google.com DIRECT" : "unexpected"}`);
  if (problems.length) {
    for (const problem of problems) console.log(`seo: ${problem}`);
    process.exit(1);
  }
  console.log("seo: pass");
}

